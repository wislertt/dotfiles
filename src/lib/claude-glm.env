# z.ai (GLM) settings shared by claude-glm and claude-glm-settings. KEY=value lines only.
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5.3-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.3-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.3-flash
ANTHROPIC_DEFAULT_FABLE_MODEL=glm-5.3-flash
# glm-5.3-flash has a 1M window; without this Claude Code assumes 200k and compacts early.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000
CLAUDE_CODE_MAX_OUTPUT_TOKENS=128000
